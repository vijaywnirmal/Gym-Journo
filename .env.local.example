NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for the account-deletion flow to remove the Supabase Auth user itself
# (not just their data). Never expose this to the browser or a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Powers the /ai-plan diet & workout generator.
GEMINI_API_KEY=your-gemini-api-key
