NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for the account-deletion flow to remove the Supabase Auth user itself
# (not just their data). Never expose this to the browser or a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which model provider AI Plan and Coach use: "gemini" (default) or "agentrouter".
# agentrouter is a third-party gateway for the DEVELOPMENT build only. For production use a provider
# with published pricing and data terms (Gemini, Claude, ...). Coach's consent text names whichever
# is active, and changing provider means people should re-confirm their consent.
AI_PROVIDER=gemini

# Server-only. Used when AI_PROVIDER=gemini. Powers /ai-plan and Coach.
GEMINI_API_KEY=your-gemini-api-key

# Server-only. Used when AI_PROVIDER=agentrouter. Never commit a real key.
AGENTROUTER_API_KEY=your-agentrouter-key
# Optional overrides (defaults shown):
# AGENTROUTER_MODEL=deepseek-v4-flash
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
